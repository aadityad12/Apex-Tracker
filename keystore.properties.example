# Template for keystore.properties, which is gitignored and must never be committed.
#
# Copy this file to keystore.properties (repo root) and fill in real values, or let
# scripts/generate_release_keystore.sh write it for you after generating a keystore.
#
# storeFile should be an ABSOLUTE path. Keeping the .jks/.keystore file itself outside this
# repo entirely (e.g. in a password manager's attachment storage, or an encrypted volume) is
# safer than relying on .gitignore alone — see docs/release-signing.md for why this file
# matters as much as it does and cannot be regenerated if lost.

storeFile=/absolute/path/to/apextracker-release.jks
storePassword=CHANGE_ME
keyAlias=apextracker
keyPassword=CHANGE_ME
